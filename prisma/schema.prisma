datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ตารางลูกค้า
model Customer {
  id          String   @id @default(uuid())
  lineUid     String   @unique @map("line_uid")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  orders      Order[]

  @@map("customers")
}

// ตารางออเดอร์งาน (พร้อมระบบคิวงาน)
model Order {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  title      String
  totalPrice Decimal   @map("total_price") @db.Decimal(10, 2)
  status     Status    @default(PENDING_DEPOSIT)
  startDate  DateTime  @default(now()) @map("start_date")
  dueDate    DateTime? @map("due_date")
  fileLink   String?   @map("file_link")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("orders")
}

// สถานะงาน
enum Status {
  PENDING_DEPOSIT
  IN_PROGRESS
  DELIVERED
}

// ตารางบทความ Blog
model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  published   Boolean   @default(false)
  coverImage  String?   @map("cover_image")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("posts")
}

// ประเภทงานที่รับทำ (สำหรับแสดงผลงาน)
model Category {
  id          String      @id @default(uuid())
  name        String      // "งาน Word", "Excel/บัญชี"
  slug        String      @unique // "word", "excel"
  icon        String?     // Emoji หรือ icon URL
  sortOrder   Int         @default(0) @map("sort_order")
  portfolios  Portfolio[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("categories")
}

// ตัวอย่างผลงาน
model Portfolio {
  id          String    @id @default(uuid())
  categoryId  String    @map("category_id")
  title       String    // "รายงานวิจัย เรื่อง..."
  description String?   @db.Text
  imageUrl    String?   @map("image_url") // URL ภาพตัวอย่าง (ไม่บังคับ — งานเอกสารไม่ต้องมี)
  published   Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}